# CompilerName=clang
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/maci64
matlabdir = /Applications/MATLAB_R2024a.app
startdir = /Users/tbryan/work/flow/training/workshops/R2024a/FixedPointMATLABWorkshopR2024a/solutions/06dftpolyphasefilterbank

# Toolchain information
cc = /usr/bin/xcrun -sdk macosx14.5 clang
cxx = /usr/bin/xcrun -sdk macosx14.5 clang++
linker = /usr/bin/xcrun -sdk macosx14.5 clang
linkerxx = /usr/bin/xcrun -sdk macosx14.5 clang++

cflags =  -fno-common -arch x86_64 -mmacosx-version-min=11.0 -fexceptions -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX14.5.sdk -fwrapv -ffp-contract=off  -DMATLAB_MEX_FILE -O2 -DNDEBUG -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=dft_polyphase_filter_mex -c 

cxxflags =  -fno-common -arch x86_64 -mmacosx-version-min=11.0 -fexceptions -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX14.5.sdk -fwrapv -ffp-contract=off  -fobjc-arc -std=c++14 -stdlib=libc++ -DMATLAB_MEX_FILE -O2 -DNDEBUG -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=dft_polyphase_filter_mex -c 

ldflags =  -Wl,-twolevel_namespace  -arch x86_64 -mmacosx-version-min=11.0 -Wl,-syslibroot,/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX14.5.sdk -bundle   -L"$matlabdir/bin/maci64" -lmx -lmex -lmat -lc++  -Wl,-rpath,@loader_path -o dft_polyphase_filter_mex.mexmaci64 -lemlrt -lcovrt -lut -lmwmathutil  -Wl,-exported_symbols_list,dft_polyphase_filter_mex.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldflags

# Build
build $builddir/dft_polyphase_filter_data.o : cc $root/dft_polyphase_filter_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/dft_polyphase_filter_initialize.o : cc $root/dft_polyphase_filter_initialize.c
build $builddir/dft_polyphase_filter_terminate.o : cc $root/dft_polyphase_filter_terminate.c
build $builddir/dft_polyphase_filter.o : cc $root/dft_polyphase_filter.c
build $builddir/fir_filter_bank.o : cc $root/fir_filter_bank.c
build $builddir/inverse_fft.o : cc $root/inverse_fft.c
build $builddir/_coder_dft_polyphase_filter_api.o : cc $root/interface/_coder_dft_polyphase_filter_api.c
build $builddir/_coder_dft_polyphase_filter_mex.o : cc $root/interface/_coder_dft_polyphase_filter_mex.c
build $builddir/_coder_dft_polyphase_filter_info.o : cc $root/interface/_coder_dft_polyphase_filter_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/dft_polyphase_filter_mex.mexmaci64 : link $builddir/dft_polyphase_filter_data.o $builddir/rt_nonfinite.o $builddir/dft_polyphase_filter_initialize.o $builddir/dft_polyphase_filter_terminate.o $builddir/dft_polyphase_filter.o $builddir/fir_filter_bank.o $builddir/inverse_fft.o $builddir/_coder_dft_polyphase_filter_api.o $builddir/_coder_dft_polyphase_filter_mex.o $builddir/_coder_dft_polyphase_filter_info.o $builddir/c_mexapi_version.o 
